# Frontend Dockerfile (multi-stage: build + nginx serve)
FROM node:22-alpine AS build

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json* ./
RUN npm install

COPY frontend/ ./
ARG VITE_API_URL=
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

FROM nginx:1.27-alpine AS runtime

# API origin for reverse-proxy (scheme + host, no trailing slash).
ARG API_UPSTREAM=http://127.0.0.1:8000
ARG API_HOST=127.0.0.1:8000
COPY backend/docker/nginx.conf /etc/nginx/conf.d/default.conf
RUN sed -i "s|__API_UPSTREAM__|${API_UPSTREAM}|g; s|__API_HOST__|${API_HOST}|g" /etc/nginx/conf.d/default.conf

COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
