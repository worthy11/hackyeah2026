DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/app
CORS_ORIGINS=http://localhost:5173
APP_NAME=HackYeah API
# https://aistudio.google.com/apikey - leave empty to disable gloss translation
GEMINI_API_KEY=
# Optional: the sentence the bundled classifier is specialized for (comma-separated glosses; this is the
# default). The video is aligned to it and falls back to free recognition if it does not fit.
# Set to an empty value to always use free recognition.
# EXPECTED_GLOSSES=ja,imię,p,i,o,t,r
# Optional: directory with classifier.pth + labels.json (default: translation/models)
# SIGN_CLASSIFIER_DIR=

# Optional: override classifier weights (defaults: translation/models/classifier.pth + labels.json)
# SIGN_CLASSIFIER_WEIGHTS=translation/models/classifier_1.pth
# SIGN_CLASSIFIER_LABELS=translation/models/labels_1.json
